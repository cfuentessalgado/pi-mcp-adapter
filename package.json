{
  "name": "pi-mcp-adapter",
  "version": "2.12.1",
  "description": "MCP (Model Context Protocol) adapter extension for Pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Cristian Fuentes Salgado",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:oauth": "node --import tsx --test --test-concurrency=1 mcp-auth.test.ts mcp-auth-flow.test.ts mcp-callback-server.test.ts mcp-oauth-provider.test.ts",
    "test:oauth-provider": "node --import tsx --test mcp-oauth-provider.test.ts",
    "test:conformance": "bash conformance/run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfuentessalgado/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.74.2",
    "@earendil-works/pi-coding-agent": "0.79.10",
    "@earendil-works/pi-tui": "0.74.2",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "@types/bun": "^1.0.0",
    "@types/node": "^20.0.0",
    "@types/open": "^6.2.1",
    "tsx": "^4.21.0",
    "typebox": "1.3.3",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "private": true
}
